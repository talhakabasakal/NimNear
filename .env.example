# NIMNear environment contract
#
# Copy values into ignored local files such as backend/.env or a process
# manager. Never commit real secrets.
#
# Classification:
#   secret            — signing keys, database passwords, Redis passwords
#   server-only       — backend host/process settings, not sent to browsers
#   public frontend   — NEXT_PUBLIC_* baked into the frontend build
#   development-only  — local convenience; unsafe as production defaults
#   production-required — must be set explicitly before a production start

# --- server-only / production-required ---
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# --- public frontend ---
# Browser origin of the Mini App. Must match CORS_ALLOWED_ORIGINS.
# Example production pair:
#   NEXT_PUBLIC_NIMNEAR_API_URL=https://api.example.com
#   CORS_ALLOWED_ORIGINS=https://app.example.com
NEXT_PUBLIC_NIMNEAR_API_URL=http://localhost:8080
NEXT_PUBLIC_NIMNEAR_NIMIQ_NETWORK=test-albatross
# NEXT_PUBLIC_NIMNEAR_PUBLIC_ORIGIN=https://app.example.com
# NEXT_PUBLIC_NIMNEAR_HUB_ENABLED=true

# See backend/.env.example and frontend/web/.env.example for the full lists.
