# NIMNear API configuration contract. Copy to .env for local use.
# Never commit real secrets.

# --- production-required / server-only ---
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT_SECONDS=15
SERVER_WRITE_TIMEOUT_SECONDS=15
SERVER_IDLE_TIMEOUT_SECONDS=60
MAX_BODY_BYTES=1048576

# Comma-separated browser origins. Production rejects empty and "*".
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com
# The frontend origin, cookie SameSite/Secure flags, and HTTPS must agree:
#   production cookies: NIMNEAR_AUTH_COOKIE_SECURE=true
#   production SameSite=None requires Secure and HTTPS
#   NEXT_PUBLIC_NIMNEAR_API_URL should be the public API origin the browser calls
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Canonical public frontend origin for payment-request share/QR links.
# Production requires HTTPS and this value must appear in CORS_ALLOWED_ORIGINS.
# NIMNEAR_PUBLIC_ORIGIN=https://app.example.com

# Reverse-proxy hops allowed to supply X-Forwarded-For. Empty ignores forwarded IPs.
NIMNEAR_TRUSTED_PROXY_CIDRS=

# --- secret / production-required ---
JWT_SECRET=change-me-in-production
JWT_ISSUER=nimnear
JWT_EXPIRATION_HOURS=24

# --- secret / production-required ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=nimnear
DB_PASSWORD=nimnear
DB_NAME=nimnear
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Isolated test database used by `make test-postgres`. Never point this at
# nimnear or a production database.
# NIMNEAR_TEST_DATABASE_URL=postgres://nimnear:nimnear@localhost:5432/nimnear_test?sslmode=disable
# NIMNEAR_TEST_DB_ISOLATED=true

# --- secret / server-only ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Production requires REDIS_TLS=true with verified TLS.
REDIS_TLS=false

# --- development-only unless Kafka is required ---
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=nimnear-go

WS_ENABLED=true
WS_MAX_CONNECTIONS=1000
# Production default is false: browser Origin is required and must match CORS.
# Development default is true so non-browser clients can omit Origin.
# WS_ALLOW_EMPTY_ORIGIN=true

# --- public Nimiq settings (not private keys) / production-required when payments are on ---
NIMNEAR_NIMIQ_NETWORK=
NIMNEAR_MERCHANT_ADDRESS=
NIMNEAR_NIMIQ_RPC_URL=

NIMNEAR_AUTH_NETWORK=test-albatross
NIMNEAR_AUTH_ENVIRONMENT=testnet
NIMNEAR_AUTH_DOMAIN=nimnear.local
NIMNEAR_AUTH_CHALLENGE_TTL_SECONDS=300
NIMNEAR_AUTH_COOKIE_NAME=nimnear_session
NIMNEAR_AUTH_COOKIE_SECURE=false
NIMNEAR_AUTH_COOKIE_SAME_SITE=lax

# --- production defaults: disabled ---
NIMNEAR_EMAIL_AUTH_ENABLED=true
NIMNEAR_PLATFORM_API_ENABLED=true
NIMNEAR_GATEWAY_TABLE_ALLOWLIST=

# Prometheus scrape on the public HTTP listener.
# Development default: enabled and public.
# Production default: enabled but not public (NIMNEAR_METRICS_PUBLIC=false).
NIMNEAR_METRICS_ENABLED=true
NIMNEAR_METRICS_PUBLIC=true

LOG_LEVEL=info
LOG_FORMAT=json
