# NIMNear frontend public configuration.
# NEXT_PUBLIC_* values are baked into the client bundle at build time.
# Do not put JWT, database, Redis, or RPC secrets here.

# --- public frontend ---
# Absolute API origin the browser calls. Must be allowed by backend CORS.
# Local: http://localhost:8080
# Production example: https://api.example.com
NEXT_PUBLIC_NIMNEAR_API_URL=http://localhost:8080

# Must match the backend NIMNEAR_AUTH_NETWORK for this deployment.
# test-albatross (development) or main-albatross (production)
NEXT_PUBLIC_NIMNEAR_NIMIQ_NETWORK=test-albatross

# Canonical public frontend origin used for payment-request share/QR links.
# Production must be HTTPS and must match backend NIMNEAR_PUBLIC_ORIGIN /
# CORS_ALLOWED_ORIGINS. Do not use a Vercel preview URL.
# NEXT_PUBLIC_NIMNEAR_PUBLIC_ORIGIN=https://app.example.com

# Set to false for Mini App-only production. Hub remains the browser fallback
# when this is unset or true. Residual @nimiq/hub-api advisory risk applies
# only while Hub fallback is enabled.
# NEXT_PUBLIC_NIMNEAR_HUB_ENABLED=true

# --- development-only ---
# Optional LAN IP advertised to Nimiq Pay during `next dev`.
# NIMNEAR_DEV_LAN_IP=192.168.1.10

# Server-side fallback used during SSR when NEXT_PUBLIC_NIMNEAR_API_URL is unset.
# NIMNEAR_API_URL=http://localhost:8080
